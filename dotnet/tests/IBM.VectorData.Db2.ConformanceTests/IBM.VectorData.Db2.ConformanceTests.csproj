<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The IBM Db2 driver does not support .NET Framework. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>IBM.VectorData.Db2.ConformanceTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MEVD9001: experimental provider-facing APIs. CA1707/CA1716/CA1720/CA2007: test names and awaits follow the conformance suite. -->
    <NoWarn>$(NoWarn);MEVD9001;CA1707;CA1716;CA1720;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IBM.VectorData.Db2\IBM.VectorData.Db2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.VectorData.ConformanceTests" />
  </ItemGroup>

</Project>
